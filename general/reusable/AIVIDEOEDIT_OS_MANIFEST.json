{
  "schema": "aivideoedit.os-manifest.v1",
  "repository": "SouthPaw302/AIVideoEdit",
  "authority_ref": "main",
  "purpose": "Critical files whose exact current-main hashes are attested at every agent-session bootstrap. The bootstrap materializes the entire main branch, not only this list.",
  "files": [
    {"path": "AGENTS.md", "role": "universal_agent_entry"},
    {"path": "SOUL.md", "role": "permanent_project_identity"},
    {"path": "README.md", "role": "repository_entry"},
    {"path": "AGENT_HANDOFF.md", "role": "handoff_contract"},
    {"path": "BIBLE.md", "role": "system_doctrine"},
    {"path": "SYSTEM_INDEX.md", "role": "system_index"},
    {"path": "projects/PROJECT_TEMPLATE.md", "role": "production_template"},
    {"path": "general/reusable/PRODUCTION_CONTRACT.json", "role": "machine_contract"},
    {"path": "general/reusable/MEDIA_CAPABILITY_MATRIX.json", "role": "media_capabilities"},
    {"path": "general/reusable/PRODUCTION_PIPELINE.md", "role": "production_pipeline"},
    {"path": "general/reusable/STYLE_CONTRACT.md", "role": "style_contract"},
    {"path": "general/reusable/LESSONS.md", "role": "reusable_lessons"},
    {"path": "general/reusable/fx_v2/registry.json", "role": "fx_registry"},
    {"path": "general/reusable/fx_v2/PRECOMPILE_FX_GATE.md", "role": "fx_gate_contract"},
    {"path": "general/reusable/tools/production_guard.py", "role": "fail_closed_guard"},
    {"path": "general/reusable/tools/README.md", "role": "tool_index"}
  ]
}

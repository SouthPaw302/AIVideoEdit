# Required public bridge authentication
BRIDGE_TOKEN=replace-with-a-long-random-token
AIVIDEOEDIT_ATTESTATION_KEY=replace-with-a-different-long-random-secret

# Public bridge port
BRIDGE_PORT=8787

# Experimental authority. Use main after explicit promotion.
AIVE_AUTHORITY_REF=MainV2

# Harness stays optional.
AIVIDEOEDIT_HARNESS_ENABLED=0
AIVIDEOEDIT_HARNESS_PROFILE=headless
